\boldsymbol{\varOmega}_{\mathfrak{H}} & =\left[\begin{array}{cccc}
\boldsymbol{\omega}_{B_{1}} & \boldsymbol{\omega}_{B_{2}} & \cdots & \boldsymbol{\omega}_{B_{9}}\end{array}\right]\nonumber \\
 & =\left[\begin{array}{cccc}
0.2582 & 0.1047 & \cdots & 0.2583\\
0.1047 & 0.2582 & \cdots & 0.1047\\
0.6370 & 0.6370 & \cdots & 0.6370
\end{array}\right]\mbox{.}\label{eq:titanium-alloy-priority-matrix}
