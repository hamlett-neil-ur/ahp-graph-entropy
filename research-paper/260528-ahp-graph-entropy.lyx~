\end_layout

\begin_layout Standard
If the hierarchy model for a given objective (or crietrion) spans 
\begin_inset Formula $n$
\end_inset

 elements,
 then 
\begin_inset Formula $\binom{n}{2}$
\end_inset

 element pairs must be considered.
 The cardinality 
\begin_inset Formula $\binom{n}{2}$
\end_inset

 specifies the range of hierarchy-model element pairs that must be considered.
 
\end_layout

\begin_layout Standard
Application of comparative judgement imposes an ordering that must subsequently be observed.
 Consider a hierarchy model 
\begin_inset Formula $\mathfrak{H}$
\end_inset

 comprised of 
\begin_inset Formula $n$
\end_inset

 elements,
 
\begin_inset Formula $\mathfrak{H}\supseteq\left\{ e_{1},\cdots,e_{n}\right\} $
\end_inset

.
 Comparative judgement 
\begin_inset Formula $\mathcal{J}_{\mathfrak{H}}$
\end_inset

 entails 
\begin_inset Formula $\binom{n}{2}$
\end_inset

 distinct mappings
\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
begin{subequations}
\end_layout

\end_inset


\begin_inset Formula 
\begin{equation}
(e_{i},e_{j}):\mathcal{J}_{\mathfrak{H}}\mapsto a_{i,j}>0\:\forall\,i\neq j\mbox{,}\label{eq:comparative-judgement-assignment}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
(e_{j},e_{i}):\mathcal{J}_{\mathfrak{H}}\mapsto a_{j,i}=a^{-1}_{i,j}\mbox{, and}
\end{equation}

\end_inset


\begin_inset Formula 
\begin{equation}
\left(e_{i},e_{i}\right):\mathcal{J}_{\mathfrak{H}}\mapsto a_{i,i}\equiv1\mbox{,}\label{eq:reciprocal-matrix-diagonal-identity}
\end{equation}

\end_inset

where 
\begin_inset Formula $a_{i,j}$
\end_inset

 denotes the reciprocal-matrix element corresponding to 
\begin_inset Formula $(e_{i},e_{j})$
\end_inset

.
 The mapping 
\begin_inset Formula $\mathcal{J}_{\mathfrak{H}}$
\end_inset

 imposes
\begin_inset Formula 
\begin{equation}
\begin{array}{c}
e_{i}\succcurlyeq e_{j}\Rightarrow a_{i,j}\geq1\\
e_{i}\prec e_{j}\Rightarrow a_{i,j}<1
\end{array}\mbox{.}
\end{equation}

\end_inset


\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
end{subequations}
\end_layout

\end_inset

Consequently,
 after applying the comparative judgement 
\begin_inset Formula $\mathcal{J}_{\mathfrak{H}}$
\end_inset

,
 element ordering must be maintained in order to accurately interpret 
\begin_inset Formula $a_{i,j}$
\end_inset

.
 By (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:comparative-judgement-assignment"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

),
 
\begin_inset Formula $a_{i,j}$
\end_inset

 is positive-definite.
 The 
\begin_inset Formula $\binom{n}{2}$
\end_inset

 distinct mappings exclude the reciprocal-matrix diagonal elements 
\begin_inset Formula $a_{i,i}$
\end_inset

,
 which by (
\begin_inset CommandInset ref
LatexCommand ref
reference "eq:reciprocal-matrix-diagonal-identity"
plural "false"
caps "false"
noprefix "false"
nolink "false"
tuple "list"

\end_inset

),
 are axiomatically assigned values of unity.
\end_layout

