\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
begin{subequations}
\end_layout

\end_inset


\begin_inset Formula 
\begin{equation}
\boldsymbol{A}_{\mathfrak{H}}=\left[\begin{array}{cccc}
1 & a_{1,2} & \cdots & a_{1,n}\\
a_{2,1} & 1 & \cdots & a_{2,n}\\
\vdots & \ddots & 1 & \vdots\\
a_{n,1} & a_{n,2} & \cdots & 1
\end{array}\right]
\end{equation}

\end_inset

subject to 
\begin_inset Formula 
\begin{equation}
a_{i,j}=a^{-1}_{j,i}\mbox{.}
\end{equation}

\end_inset


\begin_inset ERT
status open

\begin_layout Plain Layout

\backslash
end{subequations}
\end_layout

\end_inset

 
\end_layout

